# Copy this file to `.env` and fill in values from the Discord Developer Portal.
# (Only needed for running inside Discord — not for local `npm run dev` mock mode.)

# Client-side (exposed to the browser by Vite — must be prefixed VITE_)
VITE_DISCORD_CLIENT_ID=your_application_id_here
# Multiplayer WebSocket URL. Leave unset for same-origin (rides the Vite proxy /
# Discord tunnel). Local dev override example: VITE_WS_URL=ws://localhost:3001
VITE_WS_URL=

# Server-side only (never exposed to the browser)
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
PORT=3001

# Google Cloud Text-to-Speech (enable the Cloud Text-to-Speech API for the key)
GOOGLE_TTS_API_KEY=your_google_api_key_here
# Optional: GOOGLE_TTS_VOICE=en-US-Neural2-F   GOOGLE_TTS_RATE=0.9
